# Copy this file to .env and adjust the values before running the app.

# Flask
FLASK_ENV=development
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-value

# Database. SQLite is used by default (stored in instance/app.db, Flask's
# standard location for local/instance-specific files - already gitignored).
# Point this at a PostgreSQL URL in production instead, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///app.db

# Default admin account, used by `flask create-admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Default UI language: fr or en
DEFAULT_LANGUAGE=fr

# Public URL of the site (used for sitemap.xml, robots.txt and Open Graph tags)
SITE_URL=http://localhost:5000

# Privacy-friendly analytics (Plausible or Umami). Leave empty to disable.
# Plausible example:
#   ANALYTICS_SCRIPT_SRC=https://plausible.io/js/script.js
#   ANALYTICS_SCRIPT_DOMAIN=yourdomain.com
# Umami example:
#   ANALYTICS_SCRIPT_SRC=https://umami.yourdomain.com/script.js
#   ANALYTICS_SCRIPT_DOMAIN=your-website-id
ANALYTICS_SCRIPT_SRC=
ANALYTICS_SCRIPT_DOMAIN=

# Storage backend for Flask-Limiter (rate limiting on the login route).
# Defaults to in-memory, which is fine for a single-process deployment.
# Use a redis:// URL for multi-process production deployments.
RATELIMIT_STORAGE_URI=memory://
